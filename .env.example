# The app always talks to libSQL over HTTP (the same client Cloudflare
# Workers requires), so there is no local-file SQLite mode — DATABASE_URL
# must point at a real libSQL server even for local development.
#
# Cheapest local option: run `turso dev` (Turso CLI) to get a local
# libSQL-compatible HTTP server with no cloud account needed:
#   DATABASE_URL="http://127.0.0.1:8080"
#   DATABASE_AUTH_TOKEN=""
#
# Or point straight at a real Turso database (needed for `prisma migrate`
# against production, and for Cloudflare Workers — see README.md):
DATABASE_URL="libsql://your-db-name.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"
